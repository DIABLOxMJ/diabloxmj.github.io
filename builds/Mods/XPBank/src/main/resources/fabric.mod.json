{
	"schemaVersion": 1,
	"id": "xpbank",
	"version": "${version}",
	"name": "XPBank",
	"description": "A mod that adds a robust experience storage system in 3 variants and also allows you to generate experience vials against your own exp.",
	"authors": [
		"DIABLOxMJ"
	],
	"contact": {
		"homepage": "https://diabloxmj.github.io/"
	},
	"license": "CC0-1.0",
	"icon": "assets/xpbank/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.diabloxmj.xpbank.Xpbank"
		],
		"client": [
			"com.diabloxmj.xpbank.client.XpbankClient"
		]
	},
	"mixins": [
		"xpbank.mixins.json",
		{
			"config": "xpbank.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}